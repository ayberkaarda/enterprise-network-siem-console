<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.example</groupId>
	<artifactId>demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>enterprise-network-siem-console</name>
	<description>Enterprise Network SIEM Console Backend</description>

	<properties>
		<java.version>26</java.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<shedlock.version>7.9.0</shedlock.version>
		<jjwt.version>0.13.0</jjwt.version>
		<!-- Bucket4j 8.11 split its artifacts per JDK baseline; the old
		     com.bucket4j:bucket4j-core coordinate stopped at 8.10.1 and no longer
		     receives releases. The _jdk17 line is the maintained one. -->
		<bucket4j.version>8.19.0</bucket4j.version>
		<!-- springdoc-openapi 2.x targets Spring Boot 3 / Spring Framework 6; it
		     does not resolve against Boot 4.1's Spring Framework 7 baseline. 3.1.0
		     is the line built for Boot 4 / Framework 7, verified against the
		     versions actually on the classpath here rather than assumed. -->
		<springdoc.version>3.1.0</springdoc.version>
		<spotless.version>3.10.2</spotless.version>
		<palantir-java-format.version>2.98.0</palantir-java-format.version>
	</properties>

	<dependencies>
		<!-- Web ve REST API Altyapısı -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Gerçek Zamanlı İletişim -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<!-- Veritabanı ve JPA -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Request DTO doğrulaması (Jakarta Bean Validation) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Entity <-> DTO eşlemesi -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>

		<!-- Şema versiyonlama.
		     Spring Boot 4'te Flyway otomatik yapılandırması ayrı bir modüldedir;
		     yalnızca flyway-core eklemek migration'ların çalışmasını sağlamaz. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Korelasyon motorunun kayan zaman penceresi durumu icin sinirli,
		     bellek ici onbellek. Surumu Spring Boot BOM yonetir. -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Zamanlanmis gorevlerin coklu instance'ta tek seferde calismasi icin
		     dagitik kilit. Kilit, ayri bir altyapi servisi yerine uygulamanin
		     kendi veritabanindaki 'shedlock' tablosunda tutulur. -->
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-spring</artifactId>
			<version>${shedlock.version}</version>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-provider-jdbc-template</artifactId>
			<version>${shedlock.version}</version>
		</dependency>

		<!-- PostgreSQL Sürücüsü (H2 Yerine Eklendi) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- İzole, bellek içi geliştirme/test veritabanı (h2 profili) -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Spring Security (API Güvenliği İçin) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JWT üretimi ve doğrulaması.
		     jjwt-api derleme zamanı yüzeyi, impl ve jackson yalnızca çalışma
		     zamanında gerekir. jjwt-jackson, Jackson 2 (com.fasterxml) databind'e
		     dayanır; sürümü Spring Boot BOM'u yönetir, uygulamanın kendi JSON
		     katmanı Jackson 3 (tools.jackson) olarak kalır. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Olay alım uç noktasının istemci başına hız sınırı (token bucket). -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-core</artifactId>
			<version>${bucket4j.version}</version>
		</dependency>

		<!-- OpenAPI şeması + Swagger UI. Sürüm Boot BOM'u tarafından yönetilmiyor
		     (springdoc kendi Spring uyumluluk hattını sürer), bu yüzden burada
		     açıkça sabitlenir; bkz. springdoc.version yorumu. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- Test Bağımlılıkları -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Gerçek bir PostgreSQL üzerinde Flyway migration'larının ve repository
		     round-trip'lerinin doğrulandığı entegrasyon testleri için (bkz.
		     src/test/java/.../integration). Testcontainers 2.x, JUnit 5 ve
		     PostgreSQL modüllerini "testcontainers-" önekiyle yeniden adlandırdı
		     (eski koordinatlar org.testcontainers:junit-jupiter /
		     org.testcontainers:postgresql idi); sürüm Boot BOM'un import ettiği
		     testcontainers-bom'dan gelir, burada ayrıca sabitlenmez. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- MockMvc tabanlı web katmanı testleri (Spring Boot 4'te ayrı starter) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @WithMockUser ve MockMvc guvenlik filtre zinciri destegi -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Gözlemlenebilirlik: Actuator ve Prometheus -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Kod formatlama. palantir-java-format 4 boslukla girintiler ve mevcut
			     kodun stiline en yakin sonucu verir. spotless:check herhangi bir
			     Maven fazina otomatik baglanmaz (bkz. asagidaki not); CI'da ayri bir
			     adim olarak `./mvnw spotless:check` cagrilir, formatlamak icin
			     `./mvnw spotless:apply`. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
						</palantirJavaFormat>
						<removeUnusedImports/>
						<importOrder/>
						<endWithNewline/>
						<trimTrailingWhitespace/>
					</java>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>