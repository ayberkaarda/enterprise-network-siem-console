# Copy this file to .env and set real values before running docker compose.
# .env is gitignored and must never be committed.
POSTGRES_USER=siem_admin
POSTGRES_PASSWORD=change-me-before-running

# HMAC-SHA256 signing key for access/refresh tokens. Must be at least 32 bytes.
# Generate your own for real use, e.g.: openssl rand -base64 48
JWT_SECRET=please-generate-your-own-at-least-32-byte-random-secret-before-any-real-use

# Password for the bootstrapped "admin" account created on first startup.
# Change before any real use — this is the value AdminUserBootstrap falls
# back to if the variable is left unset.
SIEM_ADMIN_PASSWORD=changeme-on-first-login
